# DigitalOcean Inference API Key (Model Access Key)
# Get yours from: https://cloud.digitalocean.com/ai/inference/keys
DIGITALOCEAN_INFERENCE_KEY=

# DigitalOcean Model Name (e.g., kimi-k3 or llama-4-maverick)
DIGITALOCEAN_MODEL=kimi-k3

# DigitalOcean Serverless Inference Base URL
DIGITALOCEAN_INFERENCE_URL=https://inference.do-ai.run/v1/chat/completions

# Backend Environment & Port
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
ENABLE_AI_EXPLANATIONS=true
MAX_AI_TOKENS=500
MAX_PER_SCAN_AI_CALLS=3

# Kimi API (Moonshot AI)
# Create a key at https://platform.moonshot.ai/
MOONSHOT_API_KEY=
MOONSHOT_API_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k3
