# ==============================================================================
# CodeShield AI — Backend Configuration (.env)
# ==============================================================================

# AI Provider Selection: 'auto', 'digitalocean', 'kimi_direct', or 'mock'
AI_PROVIDER=auto

# Option 1: DigitalOcean Serverless Inference (Recommended for Kimi K3 on DO)
# Obtain your key from: https://cloud.digitalocean.com/ai/inference/keys
DIGITALOCEAN_INFERENCE_KEY=
DIGITALOCEAN_MODEL=kimi-k3
DIGITALOCEAN_INFERENCE_URL=https://inference.do-ai.run/v1/chat/completions

# Option 2: Direct Kimi / Moonshot API (takes priority over DigitalOcean in auto mode)
# Obtain from: https://platform.moonshot.ai/
MOONSHOT_API_KEY=
MOONSHOT_API_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k3

# Credit Optimization & Limits
ENABLE_AI_EXPLANATIONS=true
MAX_AI_TOKENS=600
MAX_PER_SCAN_AI_CALLS=3
REQUEST_TIMEOUT_SECONDS=15.0

# Service & Storage
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=10
MAX_EXTRACTED_FILES=50
